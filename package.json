{
  "name": "omnifex",
  "private": true,
  "version": "0.5.22",
  "productName": "OmniFex",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "node --import ./scripts/lib/register-ts.mjs scripts/dev.ts",
    "dev": "vite --config vite.web.config.ts",
    "build": "tsc && vite build --config vite.web.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:swift": "swift test --package-path macos",
    "lint": "eslint .",
    "coverage:areas": "node scripts/coverage-areas.mjs",
    "cli-review:diff": "node --no-warnings --import ./scripts/lib/register-ts.mjs scripts/cli-review-diff.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:daemon": "node scripts/build-daemon.mjs",
    "package": "node --import ./scripts/lib/register-ts.mjs scripts/package-mac.ts",
    "make": "node --import ./scripts/lib/register-ts.mjs scripts/package-mac.ts --make"
  },
