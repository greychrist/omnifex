<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- For the bundled node, Contents/MacOS/omnifexd: the daemon and the
       Brain MCP server both run on it. The Swift app takes no entitlements
       beyond hardened runtime. -->
  <dict>
    <!-- V8 compiles JavaScript to machine code at runtime and executes it.
         Hardened runtime forbids both by default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- better-sqlite3 and node-pty load as .node addons. They are signed
         with the same Team ID, which library validation accepts; this keeps
         an addon re-signed by a later build step from becoming a launch
         failure. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
