#!/bin/sh
# Run the OmniFex daemon CLI (start, stop, status, ensure, install, …).
#
# On Node 26 — the ABI better-sqlite3 and node-pty are built for. Resolution
# order: OMNIFEX_NODE (+ OMNIFEX_SERVER_SCRIPT), the repo's own build on the
# system node, the installed app's bundled node.
set -e
HERE="$(cd "$(dirname "$0")/.." && pwd)"
APP=/Applications/OmniFex.app

if [ -n "$OMNIFEX_NODE" ]; then
  NODE="$OMNIFEX_NODE"
  SCRIPT="${OMNIFEX_SERVER_SCRIPT:-$HERE/.vite/build/omnifex-server.js}"
elif [ -f "$HERE/.vite/build/omnifex-server.js" ] && command -v node >/dev/null 2>&1; then
  NODE="$(command -v node)"
  SCRIPT="$HERE/.vite/build/omnifex-server.js"
elif [ -x "$APP/Contents/MacOS/omnifexd" ]; then
  NODE="$APP/Contents/MacOS/omnifexd"
  SCRIPT="$APP/Contents/Resources/app/build/omnifex-server.js"
else
  echo "omnifex-server: nothing to run — build it (node scripts/build-daemon.mjs) or install OmniFex" >&2
  exit 1
fi

exec "$NODE" "$SCRIPT" "$@"
